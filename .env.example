# Firebase Realtime Database config for the Session tab (two-device teaching sessions).
#
# Copy to .env and fill in from your Firebase project:
#   Firebase console -> Project settings -> General -> Your apps -> SDK setup
#
# These are PUBLIC client identifiers, not secrets — they are readable in any deployed
# bundle, which is normal for Firebase web apps. Access is controlled by the database
# rules (see the Session section of README.md), not by hiding these values.
#
# Leave them unset and everything except the Session tab works exactly as before; the
# Session tab then shows setup instructions instead of a lobby.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
